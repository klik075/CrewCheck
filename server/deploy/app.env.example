# EC2의 /opt/mafia/.env 로 복사해서 값을 채운다. (이 파일 자체에는 실제 비밀번호를 넣지 말 것)
#   chmod 600 /opt/mafia/.env
SPRING_PROFILES_ACTIVE=prod

# openssl rand -base64 64 | tr -d '\n'  로 만든 값 (Base64, 256비트 이상)
JWT_SECRET=CHANGE_ME

DB_URL=jdbc:mysql://127.0.0.1:3306/mafia?serverTimezone=Asia/Seoul&characterEncoding=UTF-8
DB_USER=mafia
DB_PASSWORD=CHANGE_ME
MYSQL_ROOT_PASSWORD=CHANGE_ME

REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# 서버 모드: single(서버 1대, 기본값) / multi(서버 여러 대, 게임 저장소·잠금 전부 Redis)
# 항목 하나만 바꾸려면 GAME_REPOSITORY(memory|redis) / GAME_LOCK(local|redis) / ROOM_LOCK(local|redis) / GAME_TIMER(local|redis)
SERVER_MODE=single

# 구글 OAuth 클라이언트 ID (Google Cloud Console > 사용자 인증 정보)
GOOGLE_CLIENT_ID=CHANGE_ME.apps.googleusercontent.com
